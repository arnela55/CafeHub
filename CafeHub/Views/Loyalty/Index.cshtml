@model CafeHub.Models.User

<div class="page-wrapper">
    <h2 class="text-center mt-4">☕ Loyalty program</h2>

    <div class="card mx-auto mt-4" style="max-width: 400px;">
        <div class="card-body text-center">
            <h5>@Model.Name</h5>

            <p><strong>Bodovi:</strong> @Model.LoyaltyPoints</p>
            <p><strong>Besplatne kafe:</strong> @Model.FreeCoffees</p>

            <p class="text-muted mt-3">
                Svakih 50 bodova = 1 besplatna kafa ☕
            </p>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f9c74f;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* BIJELKASTA POZADINA IZA SVEGA */
    .page-wrapper {
        max-width: 900px;
        margin: 60px auto;
        padding: 50px;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    h2 {
        color: #4b3e2f;
        margin-bottom: 20px;
    }

    .card {
        background: rgba(255, 255, 255, 0.85);
        padding: 25px 30px;
        border-radius: 20px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: transform 0.2s;
    }

        .card:hover {
            transform: scale(1.03);
        }

        .card h5 {
            color: #4b3e2f;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .card p {
            color: #6b5b4b;
            font-size: 14px;
            margin-bottom: 10px;
        }

            .card p.text-muted {
                font-size: 12px;
                color: #8c7b6b;
            }
</style>
