@{
    ViewData["Title"] = "Feedback";
}

<div class="feedback-page">

    <div class="feedback-card">
        <h2>Vaš feedback ☕</h2>
        <p>Pomozite nam da unaprijedimo uslugu</p>

        <!-- ✅ PORUKA -->
        @if (ViewData["FeedbackMessage"] != null)
        {
            <div id="feedback-alert" class="feedback-alert @(ViewData["FeedbackClass"])">
                @ViewData["FeedbackMessage"]
            </div>
        }

        @{
            var userEmail = Context.Session.GetString("UserEmail");
        }

        @if (!string.IsNullOrEmpty(userEmail))
        {
            <!-- forma za slanje feedback-a -->
            <form method="post" action="/Feedback/Add">
                @Html.AntiForgeryToken()

                <div class="rating-stars">
                    @for (int i = 5; i >= 1; i--)
                    {
                        <input type="radio" id="star-@i" name="rating" value="@i" />
                        <label for="star-@i">★</label>
                    }
                </div>

                <textarea name="comment" placeholder="Napišite vaš komentar..." required></textarea>

                <button type="submit" class="btn-submit">Pošalji feedback</button>
            </form>
        }
        else
        {
            <p class="feedback-warning">
                Morate biti prijavljeni da biste poslali feedback.
            </p>
        }

    </div>
</div>

<!-- 🎨 STYLING -->
<style>
    body {
        background-color: #f9c74f;
    }

    .feedback-page {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .feedback-card {
        background: #fdecc2;
        padding: 35px;
        border-radius: 20px;
        width: 380px;
        text-align: center;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        position: relative;
    }

        .feedback-card h2 {
            color: #4b3e2f;
            margin-bottom: 5px;
        }

        .feedback-card p {
            color: #6b5b4b;
            font-size: 14px;
            margin-bottom: 20px;
        }

    .rating-stars {
        display: flex;
        flex-direction: row-reverse;
        justify-content: center;
        margin-bottom: 20px;
    }

        .rating-stars input {
            display: none;
        }

        .rating-stars label {
            font-size: 30px;
            color: #ddd;
            cursor: pointer;
            transition: 0.2s;
        }

            .rating-stars input:checked ~ label,
            .rating-stars label:hover,
            .rating-stars label:hover ~ label {
                color: #b07a42;
            }

    textarea {
        width: 100%;
        height: 100px;
        padding: 12px;
        border-radius: 12px;
        border: none;
        resize: none;
        outline: none;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .btn-submit {
        background-color: #4b3e2f;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 14px;
    }

        .btn-submit:hover {
            background-color: #3a2f23;
        }

    .feedback-alert {
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 15px;
        font-weight: 500;
        text-align: center;
        transition: opacity 0.5s ease;
    }

        .feedback-alert.success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .feedback-alert.warning {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }

    .feedback-warning {
        color: #856404;
        font-weight: 500;
    }
</style>

<!-- 💨 AUTOMATSKO NESTAJANJE PORUKE -->
<script>
    window.addEventListener("DOMContentLoaded", () => {
        const alert = document.getElementById("feedback-alert");
        if (alert) {
            setTimeout(() => {
                alert.style.opacity = "0";
                setTimeout(() => alert.remove(), 500);
            }, 4000); // nestaje nakon 4 sekunde
        }
    });
</script>
