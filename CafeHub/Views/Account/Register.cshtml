@{
    ViewData["Title"] = "Registracija";
}

<div class="login-container">
    <div class="login-card">
        <h2>Registracija</h2>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="error">@ViewBag.ErrorMessage</div>
        }

        <form method="post">
            <input type="text" name="FullName" placeholder="Ime i prezime" required />
            <input type="email" name="Email" placeholder="Email" required />
            <input type="tel" name="PhoneNumber" placeholder="Broj telefona" required />
            <input type="password" name="Password" placeholder="Lozinka" required />

            <button type="submit">Registruj se</button>
        </form>

        <div class="login-bottom-text">
            Imate nalog? <a asp-action="Login">Prijavite se</a>
        </div>
    </div>
</div>
