@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="employee-dashboard">
    <h2 class="dashboard-title">Employee Dashboard</h2>
    <p class="dashboard-subtitle">
        Trenutno imate <strong>@Model.NewOrdersCount novih narudžbi</strong> i
        <strong>@Model.ActiveReservationsCount aktivnih rezervacija</strong>.
        Kliknite na kartice ispod za detalje i upravljanje.
    </p>

    <div class="dashboard-cards">

        <!-- NARUDŽBE -->
        <a asp-controller="Employee" asp-action="Orders" class="dashboard-card orders">
            <div class="card-icon">🛒</div>
            <div class="card-title">Narudžbe</div>
            <div class="card-desc">@Model.NewOrdersCount novih</div>
        </a>

        <!-- REZERVACIJE -->
        <a asp-controller="Employee" asp-action="Reservations" class="dashboard-card reservations">
            <div class="card-icon">🪑</div>
            <div class="card-title">Rezervacije</div>
            <div class="card-desc">@Model.ActiveReservationsCount aktivnih</div>
        </a>


    </div>
</div>
