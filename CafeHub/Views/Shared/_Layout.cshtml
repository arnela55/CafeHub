<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CafeHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CafeHub.styles.css" asp-append-version="true" />
</head>
<body style="margin:0; padding:0;">
    <header id="header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">

            <div class="container-fluid">
                <a class="navbar-brand cafehub-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="logo-icon">☕</span> CafeHub
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Glavni linkovi lijevo -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Početna</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Menu" asp-action="Index">Meni</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Reservation" asp-action="Index">Rezervacije</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Gallery" asp-action="Index">Galerija</a>
                        </li>
                    </ul>

                    <!-- Corner login/registracija desno -->
                    <div class="d-flex align-items-center">
                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                            <span class="navbar-text me-2">Dobrodošli, @Context.Session.GetString("UserName")</span>
                            <a class="btn btn-outline-dark" asp-controller="Account" asp-action="Logout">Odjavi se</a>

                        }
                        else
                        {
                            <a class="btn btn-outline-dark me-2" asp-controller="Account" asp-action="Login">Prijava</a>
                            <a class="btn btn-dark" asp-controller="Account" asp-action="Register">Registracija</a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CafeHub - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
