<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CafeHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CafeHub.styles.css" asp-append-version="true" />
</head>
<body style="margin:0; padding:0;">
    <header id="header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3 bg-dark">
            <div class="container-fluid">
                <!-- Logo -->
                <a class="navbar-brand cafehub-logo text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="logo-icon">☕</span> CafeHub
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <!-- Glavni linkovi lijevo -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Početna</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Menu" asp-action="Index">Meni</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Reservation" asp-action="Index">Rezervacije</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Gallery" asp-action="Index">Galerija</a>
                        </li>
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserEmail")))
                        {
                            var email = Context.Session.GetString("UserEmail");
                            var user = DatabaseModel.Users.FirstOrDefault(u => u.Email == email);

                            if (user != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" id="loyaltytitle" asp-controller="Loyalty" asp-action="Index">
                                        ☕ Loyalty (@user.LoyaltyPoints bodova)
                                    </a>
                                </li>
                            }
                        }


                    </ul>

                    <div class="nav-actions d-flex align-items-center">

                        <!-- FEEDBACK dugme -->
                        <a href="/Feedback"
                           class="btn btn-feedback position-relative"
                           title="Ostavite feedback">
                            💬
                        </a>

                        <!-- Mini-cart dugme -->
                        <a href="/Order/Cart" class="btn btn-circle position-relative">
                            🛒
                            <span class="cart-count">@ViewBag.CartCount</span>
                        </a>

                        <!-- LOGIN / REGISTER ili korisnik -->
                        <div class="login-group d-flex align-items-center gap-2">
                            @if (Context.Session.GetString("UserEmail") != null)
                            {
                                <span class="navbar-text text-white">
                                    Dobrodošli, @Context.Session.GetString("UserName")
                                </span>
                                <a class="btn btn-outline-light btn-sm"
                                   asp-controller="Account"
                                   asp-action="Logout">Odjavi se</a>
                            }
                            else
                            {
                                <div class="login-group">
                                    <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Prijava</a>
                                    <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Registracija">Registracija</a>
                                </div>

                            }
                        </div>
                    </div>


                </div>
            </div>
        </nav>
    </header>



    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CafeHub - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
